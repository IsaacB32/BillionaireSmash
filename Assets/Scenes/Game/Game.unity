      propertyPath: 'sentences.Array.data[0]'
      value: 'the year is 2027

        only one billionaire remains on earth

        his
        name: <color=green>jonathan capitalist</color>'
      objectReference: {fileID: 0}
    - target: {fileID: 1963401131718467100, guid: 1b99990ea6506c934b42cf97045a87fa, type: 3}
      propertyPath: 'sentences.Array.data[1]'
      value: "with only a small amount of his money \nhe solved world hunger"
      objectReference: {fileID: 0}
    - target: {fileID: 1963401131718467100, guid: 1b99990ea6506c934b42cf97045a87fa, type: 3}
      propertyPath: 'sentences.Array.data[2]'
      value: 'then he created the money monsters,

        creatures made entirely
        out of money'
      objectReference: {fileID: 0}
    - target: {fileID: 1963401131718467100, guid: 1b99990ea6506c934b42cf97045a87fa, type: 3}
      propertyPath: 'sentences.Array.data[3]'
      value: 'the money monsters took over earth,

        allowing john to seize
        all property

        with plans to build many <color=yellow>ai</color> data
        centers'
      objectReference: {fileID: 0}
    - target: {fileID: 1963401131718467100, guid: 1b99990ea6506c934b42cf97045a87fa, type: 3}
      propertyPath: 'sentences.Array.data[4]'
      value: 'now John is coming for your farm,

